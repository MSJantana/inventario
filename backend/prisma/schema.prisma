// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums para Equipamento
enum TipoEquipamento {
  COMPUTADOR
  NOTEBOOK
  IMPRESSORA
  PROJETOR
  TABLET
  MONITOR
  ROTEADOR
  SWITCH
  OUTRO
}

enum StatusEquipamento {
  DISPONIVEL
  EM_USO
  EM_MANUTENCAO
  DESCARTADO
  RESERVADO
  EMPRESTADO
  DOADO
}

// Enums para Centro de Midia
enum TipoMidia {
  AUDIO
  VIDEO
  CAMERA
  MICROFONE
  ILUMINACAO
  OUTRO
}

// Enum para Movimentação
enum TipoMovimento {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  MANUTENCAO
  DESCARTE
  MANUTENCAO_ENVIO
  MANUTENCAO_RETORNO
  EMPRESTIMO
  DEVOLUCAO
  DOACAO
  AJUSTE
}

// Enum para Roles de Usuário
enum Role {
  ADMIN
  GESTOR
  TECNICO
  USUARIO
}

// Enum para logs de importação WinAudit
enum StatusImportacao {
  PREVIEW_GERADO
  SUCESSO
  CANCELADO
  ERRO
}

model Equipamento {
  id            String                 @id @default(uuid())
  nome          String
  patrimonio    String?
  tipo          TipoEquipamento
  modelo        String
  serial        String                 @unique
  status        StatusEquipamento      @default(EM_USO)
  localizacao   String?
  fabricante    String?
  dataAquisicao DateTime
  processador   String?
  memoria       String?
  macaddress    String?
  observacoes   String?
  usuarioNome   String?
  setor         String?
  responsavel   String?
  escolaId      String?
  escola        Escola?                @relation(fields: [escolaId], references: [id])
  movimentacoes Movimentacao[]
  importacoesWinAudit ImportacaoWinAudit[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model Usuario {
  id               String               @id @default(uuid())
  nome             String
  email            String               @unique
  senha            String
  role             Role                 @default(USUARIO)
  cargo            String?
  resetToken       String?              @db.VarChar(255)
  resetTokenExpiry DateTime?
  escolaId         String?
  escola           Escola?              @relation(fields: [escolaId], references: [id])
  escolasAcesso    UsuarioEscola[]
  importacoesWinAudit ImportacaoWinAudit[] @relation("UsuarioImportacoes")
  movimentacoes    Movimentacao[]       @relation("UsuarioMovimentacoes")
  movimentacoesEstorno Movimentacao[]   @relation("MovimentacaoEstorno")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Movimentacao {
  id                      String        @id @default(uuid())
  equipamentoId           String
  equipamento             Equipamento   @relation(fields: [equipamentoId], references: [id])
  responsavel             String
  tipoMovimento           TipoMovimento
  origem                  String?
  destino                 String?
  escolaId                String?
  escola                  Escola?       @relation(fields: [escolaId], references: [id])
  dataMovimento           DateTime      @default(now())
  observacoes             String?
  // Auditoria & Snapshots
  usuarioId               String?
  usuario                 Usuario?      @relation("UsuarioMovimentacoes", fields: [usuarioId], references: [id])
  snapshotAntes           Json?
  snapshotDepois          Json?
  // Estorno auditável
  estornado               Boolean       @default(false)
  estornadoEm             DateTime?
  estornadoPorUsuarioId   String?
  estornadoPorUsuario     Usuario?      @relation("MovimentacaoEstorno", fields: [estornadoPorUsuarioId], references: [id])
  motivoEstorno           String?       @db.Text
  movimentacaoEstornoId   String?       @unique
  movimentacaoEstorno     Movimentacao? @relation("MovEstornoPar", fields: [movimentacaoEstornoId], references: [id])
  movimentacaoOriginal    Movimentacao? @relation("MovEstornoPar")
  manutencao              MovimentacaoManutencao?
  doacao                  MovimentacaoDoacao?
  emprestimo              MovimentacaoEmprestimo?
  retornosManutencao      MovimentacaoManutencao[] @relation("ManutEnvioRet")
  retornosEmprestimo      MovimentacaoEmprestimo[] @relation("EmpSaidaDev")

  @@index([escolaId, tipoMovimento, dataMovimento])
  @@index([equipamentoId, dataMovimento])
  @@index([usuarioId, dataMovimento])
  @@index([dataMovimento])
  @@index([estornado, dataMovimento])
}

model MovimentacaoManutencao {
  id                  String        @id @default(uuid())
  movimentacaoId      String        @unique
  movimentacao        Movimentacao  @relation(fields: [movimentacaoId], references: [id], onDelete: Cascade)
  movimentacaoEnvioId String?
  movimentacaoEnvio   Movimentacao? @relation("ManutEnvioRet", fields: [movimentacaoEnvioId], references: [id], onDelete: SetNull)
  tipoServico         String?
  tecnicoResponsavel  String?
  fornecedorNome      String?
  fornecedorContato   String?
  numeroOS            String?
  prazoRetorno        DateTime?
  dataRetornoEfetiva  DateTime?
  pecasTrocadas       Json?
  valorServico        Decimal?      @db.Decimal(12, 2)
  laudoTecnico        String?       @db.Text
  escolaId            String?
  escola              Escola?       @relation(fields: [escolaId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([movimentacaoEnvioId])
}

model MovimentacaoDoacao {
  id                  String        @id @default(uuid())
  movimentacaoId      String        @unique
  movimentacao        Movimentacao  @relation(fields: [movimentacaoId], references: [id], onDelete: Cascade)
  beneficiarioNome    String
  beneficiarioCpfCnpj String?
  beneficiarioContato String?
  enderecoEntrega     String?
  termoDoacaoUrl      String?
  numeroPortaria      String?
  dataEntregaEfetiva  DateTime?
  responsavelEntrega  String?
  observacoesInternas String?       @db.Text
  escolaId            String?
  escola              Escola?       @relation(fields: [escolaId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model MovimentacaoEmprestimo {
  id                       String        @id @default(uuid())
  movimentacaoId           String        @unique
  movimentacao             Movimentacao  @relation(fields: [movimentacaoId], references: [id], onDelete: Cascade)
  movimentacaoSaidaId      String?
  movimentacaoSaida        Movimentacao? @relation("EmpSaidaDev", fields: [movimentacaoSaidaId], references: [id], onDelete: SetNull)
  beneficiarioNome         String
  beneficiarioDocumento    String?
  beneficiarioContato      String?
  tomadorNome              String?
  tomadorCargo             String?
  localDestino             String?
  dataSaida                DateTime?
  dataPrevistaDevolucao    DateTime?
  dataDevolucaoEfetiva     DateTime?
  estadoConservacaoSaida   String?
  estadoConservacaoRetorno String?
  termoAssinado            Boolean?      @default(false)
  termoUrl                 String?
  observacoesInternas      String?       @db.Text
  escolaId                 String?
  escola                   Escola?       @relation(fields: [escolaId], references: [id])
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([movimentacaoSaidaId])
}

model Escola {
  id             String               @id @default(uuid())
  nome           String
  sigla          String
  endereco       String
  cidade         String
  estado         String
  cep            String
  telefone       String?
  email          String?
  diretor        String?
  observacoes    String?
  equipamentos   Equipamento[]
  usuarios       Usuario[]
  usuariosAcesso UsuarioEscola[]
  movimentacoes  Movimentacao[]
  movimentacoesManutencao MovimentacaoManutencao[]
  movimentacoesDoacao MovimentacaoDoacao[]
  movimentacoesEmprestimo MovimentacaoEmprestimo[]
  centroMidia    CentroMidia[]
  importacoesWinAudit ImportacaoWinAudit[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model UsuarioEscola {
  usuarioId String
  escolaId  String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  escola  Escola  @relation(fields: [escolaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, escolaId])
  @@index([escolaId])
}

model CentroMidia {
  id        String           @id @default(uuid())
  nome      String
  tipo      TipoMidia
  modelo    String
  serial    String           @unique
  status    StatusEquipamento @default(DISPONIVEL)
  escolaId  String?
  escola    Escola?          @relation(fields: [escolaId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// Logs de importacao de arquivo WinAudit (auditoria + confirmacao de preview)
model ImportacaoWinAudit {
  id                     String           @id @default(uuid())
  usuarioId              String
  usuario                Usuario          @relation("UsuarioImportacoes", fields: [usuarioId], references: [id])
  dataHora               DateTime         @default(now())
  arquivoOriginal        String           @db.VarChar(512)
  tamanhoBytes           Int?
  tipoArquivo            String?          @db.VarChar(32)
  status                 StatusImportacao
  equipamentoId          String?
  equipamento            Equipamento?     @relation(fields: [equipamentoId], references: [id])
  camposEncontrados      Json
  camposNaoEncontrados   Json
  duplicidadesDetectadas Json
  erros                  Json?
  dadosBrutos            Json?
  erroMotivo             String?          @db.Text
  escolaId               String?
  escola                 Escola?              @relation(fields: [escolaId], references: [id])
  ipOrigem               String?          @db.VarChar(64)
  versaoImportador       String?          @db.VarChar(32)
  duracaoMs              Int?
  qtdCamposEncontrados   Int?
  qtdCamposImportados    Int?

  @@index([usuarioId])
  @@index([equipamentoId])
  @@index([escolaId])
  @@index([status, dataHora])
}
